#!/bin/bash
#MISE description="Wait for env-mode realms to finish their boot index and be publicly readable; fail fast when the service stack is gone"

# Usage:
#   mise run ci:wait-for-realms realm=<url> [realm=<url> ...] \
#     [ready=<url> ...] [icons=<url>] \
#     [stack-pid-file=<path>] [stack-started-file=<path>]
#
#   realm=  A realm whose `_readiness-check` must reach 200 and whose `_info`
#           must then be readable without authentication (public-read parity).
#   ready=  A realm whose `_readiness-check` must reach 200; no parity check.
#   icons=  A stable file on the icons server to probe until it returns 200.
#           The icons server has no readiness endpoint of its own.
#   stack-pid-file=
#           File holding the pid of the backgrounded service stack. When that
#           process is gone there is nothing left to wait for.
#   stack-started-file=
#           File holding the epoch second the service stack was started. The
#           time budget is measured from there rather than from this script's
#           start, so however long the steps in between took, this script
#           still gives up before the stack does.
#
# Every target is polled in the order given. Each non-200 answer is logged
# with what the realm-server said it was waiting for (the `X-Boxel-Not-Ready`
# header) or, for any other status, the content type and the first line of the
# body — which is what tells a Traefik-originated `404 page not found` apart
# from a realm-server 404.
#
# Three conditions end the wait early instead of running the whole budget
# down against an environment that can no longer become ready:
#   - the service stack process has exited;
#   - a host that the realm-server had been answering for now gets Traefik's
#     own 404, i.e. its route file was removed (the realm-server deregisters
#     every route for the environment on shutdown);
#   - the time budget is spent.
# Each failure prints the failing URL's response headers and the Traefik
# diagnostics (ci:traefik-diagnostics) before exiting, while the stack is
# still up to be inspected.
set -uo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
ACCEPT='application/vnd.api+json'
READY_PATH='_readiness-check?acceptHeader=application%2Fvnd.api%2Bjson'
INFO_PATH='_info'

# `test-services/host` runs the stack under start-server-and-test with a
# 900 s WAIT_ON_TIMEOUT on base readiness. When that expires it kills the
# stack, the realm-server deregisters its Traefik routes on the way down, and
# from then on every probe answers 404 and nothing is left to diagnose. This
# budget stays a minute inside that so a genuine hang fails here, with the
# stack alive and its state captured, rather than there. A healthy cold boot
# has every realm here ready in well under five minutes.
BUDGET_SECS="${WAIT_FOR_REALMS_TIMEOUT_SECS:-840}"

realms=()
ready_only=()
icons_probe=""
pid_file=""
started_file=""

usage() {
  sed -n '4,20p' "$0" >&2
  exit 2
}

for arg in "$@"; do
  case "$arg" in
    realm=*) realms+=("${arg#realm=}") ;;
    ready=*) ready_only+=("${arg#ready=}") ;;
    icons=*) icons_probe="${arg#icons=}" ;;
    stack-pid-file=*) pid_file="${arg#stack-pid-file=}" ;;
    stack-started-file=*) started_file="${arg#stack-started-file=}" ;;
    *)
      echo "unrecognised argument: $arg" >&2
      usage
      ;;
  esac
done
[ "${#realms[@]}" -gt 0 ] || usage

origin=$(date +%s)
if [ -n "$started_file" ] && [ -r "$started_file" ]; then
  started="$(tr -dc '0-9' < "$started_file")"
  if [ -n "$started" ]; then
    origin=$started
  fi
fi
deadline=$((origin + BUDGET_SECS))
echo "budget: ${BUDGET_SECS}s from the stack's start, $(( $(date +%s) - origin ))s of it already spent"

# --- probing -----------------------------------------------------------------

# Globals set by probe(): the HTTP status ("000" when nothing answered), the
# X-Boxel-Not-Ready stage, the content type, and the first line of the body
# (or of curl's error when there was no response).
code=""
not_ready=""
ctype=""
body_line=""

probe() {
  local url=$1 headers body err
  headers=$(mktemp)
  body=$(mktemp)
  err=$(mktemp)
  code=$(curl -sS -o "$body" -D "$headers" -w '%{http_code}' \
    -H "Accept: ${ACCEPT}" --max-time 15 "$url" 2>"$err") || code=000
  not_ready=$(awk 'tolower($1) == "x-boxel-not-ready:" { print $2 }' "$headers" | tr -d '\r')
  ctype=$(awk 'tolower($1) == "content-type:" { print $2 }' "$headers" | tr -d '\r;')
  if [ "$code" = "000" ]; then
    body_line=$(head -c 160 "$err" | tr '\n' ' ')
  else
    body_line=$(head -c 160 "$body" | tr '\n' ' ')
  fi
  rm -f "$headers" "$body" "$err"
}

# One-line rendering of the last probe for the log.
describe() {
  case "$code" in
    200) printf '200' ;;
    503) printf '503 not-ready=%s' "${not_ready:-unknown}" ;;
    000) printf 'no response (%s)' "$body_line" ;;
    *) printf '%s %s "%s"' "$code" "${ctype:-no-content-type}" "$body_line" ;;
  esac
}

# Traefik answers a host no router matches with this exact plain-text body.
# Anything else on a 404 came from a backend.
is_traefik_404() {
  [ "$code" = "404" ] || return 1
  case "$body_line" in
    "404 page not found"*) return 0 ;;
  esac
  return 1
}

# Whether the last probe was answered by the realm-server rather than by the
# proxy in front of it: a 200, a 503 carrying the not-ready stage, or any
# JSON:API body.
realm_server_answered() {
  [ "$code" = "200" ] && return 0
  [ -n "$not_ready" ] && return 0
  case "$ctype" in
    application/vnd.api+json*) return 0 ;;
  esac
  return 1
}

url_host() {
  local u=${1#*://}
  printf '%s' "${u%%/*}"
}

url_label() {
  local u=${1#*://}
  printf '%s' "${u%%\?*}"
}

routed_hosts=" "
mark_routed() { routed_hosts="${routed_hosts}$1 "; }
was_routed() { case "$routed_hosts" in *" $1 "*) return 0 ;; esac; return 1; }

# --- failure -----------------------------------------------------------------

fail() {
  local url=$1 message=$2
  echo "::error::${message}"
  echo "::group::response headers for ${url}"
  curl -sSv -o /dev/null -H "Accept: ${ACCEPT}" --max-time 15 "$url" 2>&1 \
    | grep -E '^[<>*] ' | head -40 || true
  echo "::endgroup::"
  if [ -n "$pid_file" ] && [ -r "$pid_file" ]; then
    local pid
    pid="$(tr -dc '0-9' < "$pid_file")"
    if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
      echo "service stack pid ${pid} is still running"
    else
      echo "service stack pid ${pid:-?} has exited"
    fi
  fi
  echo "::group::Traefik diagnostics"
  "$SCRIPT_DIR/traefik-diagnostics" || true
  echo "::endgroup::"
  exit 1
}

check_stack_alive() {
  local label=$1 pid
  [ -n "$pid_file" ] && [ -r "$pid_file" ] || return 0
  pid="$(tr -dc '0-9' < "$pid_file")"
  [ -n "$pid" ] || return 0
  kill -0 "$pid" 2>/dev/null && return 0
  fail "$2" "the service stack (pid ${pid}) exited while waiting for ${label}; the server log shows what stopped it"
}

# --- waiting -----------------------------------------------------------------

wait_for_200() {
  local url=$1 label host attempt=0
  label=$(url_label "$url")
  host=$(url_host "$url")
  while :; do
    attempt=$((attempt + 1))
    probe "$url"
    if [ "$code" = "200" ]; then
      echo "t+${SECONDS}s  ${label} -> 200 (attempt ${attempt})"
      mark_routed "$host"
      return 0
    fi
    echo "t+${SECONDS}s  ${label} -> $(describe)"
    if realm_server_answered; then
      mark_routed "$host"
    elif is_traefik_404 && was_routed "$host"; then
      fail "$url" "Traefik no longer has a route for ${host}: the realm-server had been answering for it, so its route file was removed — the service stack was torn down or the service deregistered itself"
    fi
    check_stack_alive "$label" "$url"
    if [ "$(date +%s)" -ge "$deadline" ]; then
      fail "$url" "${label} did not return 200 within the ${BUDGET_SECS}s budget (last answer: $(describe))"
    fi
    sleep 5
  done
}

for realm in "${realms[@]}"; do
  wait_for_200 "${realm%/}/${READY_PATH}"
done

# Public-read parity: `_info` must answer 200 with no credentials. A realm
# that indexed but is not publicly readable fails every unauthenticated
# fetch the tests make against it.
for realm in "${realms[@]}"; do
  info_url="${realm%/}/${INFO_PATH}"
  probe "$info_url"
  echo "t+${SECONDS}s  $(url_label "$info_url") -> $(describe)"
  if [ "$code" != "200" ]; then
    fail "$info_url" "public-read parity broken: $(url_label "$info_url") answered $(describe) without credentials"
  fi
done

if [ -n "$icons_probe" ]; then
  wait_for_200 "$icons_probe"
fi

# Guarded rather than iterated directly: expanding an empty array under
# `set -u` is an error in bash before 4.4, which is what macOS ships.
if [ "${#ready_only[@]}" -gt 0 ]; then
  for realm in "${ready_only[@]}"; do
    wait_for_200 "${realm%/}/${READY_PATH}"
  done
fi

echo "::notice::Environment-mode realms ready and publicly readable after ${SECONDS}s: ${realms[*]}"
