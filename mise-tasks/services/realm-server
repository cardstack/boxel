#!/usr/bin/env bash
#MISE description="Start realm development server"
#MISE depends=["infra:ensure-dev-cert", "infra:ensure-traefik", "infra:ensure-pg", "infra:ensure-db", "infra:wait-for-prerender"]
#MISE dir="packages/realm-server"

# Propagate realm-server's exit status through the trailing `| dev-log-tee.sh`
# pipeline so mise sees crashes instead of the tee stage's clean EOF.
# `set -o pipefail` is a bashism — Ubuntu CI's /bin/sh is dash and rejects it
# as "Illegal option", so this script must run under bash.
set -o pipefail

SCRIPTS_DIR="./scripts"
# Tee stdout+stderr to a per-service log file so the local Alloy scraper
# (packages/observability/alloy/config.alloy) can pick this up via
# loki.source.file. Alloy's Docker discovery doesn't see native processes.
LOG_TEE="../observability/scripts/dev-log-tee.sh"

# Started here so that dev-all, which does not list services:icons, still has
# an icons server. The stacks that do list it start one as well; start-icons.sh
# steps aside when icons already answer for this environment, so either order
# leaves one server registered.
sh "$SCRIPTS_DIR/start-icons.sh" &
ICONS_PID=$!
cleanup_icons_server() {
  if [ -n "$ICONS_PID" ]; then
    kill "$ICONS_PID" >/dev/null 2>&1 || true
  fi
}
# EXIT runs cleanup unconditionally. INT/TERM additionally exit 0 so that the
# 143-on-Ctrl-C from the node pipeline below isn't reported by mise /
# run-p as "task failed" — see mise-tasks/services/worker for the broader
# rationale. Real crashes still propagate (node faulting on its own
# leaves the trap unfired, so pipefail's 143-aware exit code wins).
# The signal handler clears the EXIT trap before exiting so cleanup doesn't
# run twice in succession.
trap cleanup_icons_server EXIT
trap 'trap - EXIT; cleanup_icons_server; exit 0' INT TERM

pnpm --dir=../skills-realm skills:setup

if [ -z "${SKIP_BOXEL_HOMEPAGE:-}" ]; then
  pnpm --dir=../boxel-homepage-realm boxel-homepage:setup
fi

# The catalog realm is served from one of two places. By default it is the
# full boxel-catalog clone, merged with the pinned test subset: subset files
# the clone lacks are added to it, so boxel's tests find the definitions they
# pin. CATALOG_SOURCE=test-subset serves only the pinned subset, which is what
# the test stacks use in place of cloning the whole catalog.
CATALOG_PATH='../catalog/contents'
CATALOG_TOUCH=''
if [ "${SKIP_CATALOG:-}" != "true" ]; then
  if [ "${CATALOG_SOURCE:-}" = "test-subset" ]; then
    CATALOG_PATH='../catalog/test-subset'
    CATALOG_TOUCH='test-subset'
    pnpm --dir=../catalog catalog:test-subset || exit 1
  else
    pnpm --dir=../catalog catalog:setup
    pnpm --dir=../catalog catalog:update
    pnpm --dir=../catalog catalog:test-subset --into-clone --best-effort
    CATALOG_TOUCH='clone'
  fi
fi

if [ -z "$MATRIX_REGISTRATION_SHARED_SECRET" ]; then
  MATRIX_REGISTRATION_SHARED_SECRET=$(node "$SCRIPTS_DIR/matrix-registration-secret.ts")
  export MATRIX_REGISTRATION_SHARED_SECRET
fi

START_EXPERIMENTS=$(if [ -z "$SKIP_EXPERIMENTS" ]; then echo "true"; else echo ""; fi)
START_CATALOG=true
if [ "${SKIP_CATALOG:-}" = "true" ]; then
  START_CATALOG=""
fi
START_SOFTWARE_FACTORY=true
if [ "${SKIP_SOFTWARE_FACTORY:-}" = "true" ]; then
  START_SOFTWARE_FACTORY=""
fi
START_BOXEL_HOMEPAGE=$(if [ -z "$SKIP_BOXEL_HOMEPAGE" ]; then echo "true"; else echo ""; fi)
START_SUBMISSION=$(if [ -z "$SKIP_SUBMISSION" ]; then echo "true"; else echo ""; fi)

DEFAULT_CATALOG_REALM_URL="${REALM_BASE_URL}/catalog/"
CATALOG_REALM_URL="${RESOLVED_CATALOG_REALM_URL:-$DEFAULT_CATALOG_REALM_URL}"
DEFAULT_SOFTWARE_FACTORY_REALM_URL="${REALM_BASE_URL}/software-factory/"
SOFTWARE_FACTORY_REALM_URL="${RESOLVED_SOFTWARE_FACTORY_REALM_URL:-$DEFAULT_SOFTWARE_FACTORY_REALM_URL}"
DEFAULT_BOXEL_HOMEPAGE_REALM_URL="${REALM_BASE_URL}/boxel-homepage/"
BOXEL_HOMEPAGE_REALM_URL="${RESOLVED_BOXEL_HOMEPAGE_REALM_URL:-$DEFAULT_BOXEL_HOMEPAGE_REALM_URL}"
DEFAULT_SUBMISSION_REALM_URL="${REALM_BASE_URL}/submissions/"
SUBMISSION_REALM_URL="${RESOLVED_SUBMISSION_REALM_URL:-$DEFAULT_SUBMISSION_REALM_URL}"

SUBMISSION_REALM_PATH="${SUBMISSION_REALM_PATH:-${REALMS_ROOT}/submissions}"

if [ -n "$START_SUBMISSION" ]; then
  sh "$SCRIPTS_DIR/setup-submission-realm.sh" "$SUBMISSION_REALM_PATH"
fi

if [ -n "$ENV_MODE" ]; then
  WORKER_MANAGER_ARG="--workerManagerUrl=${WORKER_MGR_URL}"
else
  WORKER_MANAGER_ARG="$1"
fi

# The compiled-module cache survives restarts, and a read never checks a
# cached compile against its file, so subset files the sync rewrote above
# could be served from a compile of their old content. A catalog realm that
# runs a boot index drops its whole cache (before the index starts when the
# realm already has an index, and again when it completes), so only one that
# mounts without a boot index keeps stale entries. In that case, once the
# catalog realm answers, touch the subset files so its file watcher clears
# them.
#
# The touch is skipped after a boot index because it is not free: each touched
# file queues an incremental index of the catalog behind whatever the stack's
# workers already hold (on a single-worker stack, the catalog's own boot
# prerender pass), and the catalog's `_readiness-check` answers not-ready until
# that index completes.
#
# Whether the boot index ran is read from the queue rather than inferred from
# REALM_SERVER_SKIP_BOOT_INDEX and REALM_SERVER_FULL_INDEX_ON_STARTUP: the
# realm server decides it from those together with whether the catalog already
# has an index. A boot index is a from-scratch-index job for the catalog
# enqueued after the baseline taken here. When the queue can't be read, the
# touch runs.
if [ -n "$CATALOG_TOUCH" ]; then
  . ../../scripts/pg-container.sh
  # The highest job id before this boot: 0 on a database the realm server has
  # yet to migrate, empty when the queue can't be read.
  if [ "$(boxel_pg_psql -d "$PGDATABASE" -tAc "SELECT to_regclass('jobs') IS NULL" 2>/dev/null)" = "t" ]; then
    CATALOG_JOBS_BASELINE=0
  else
    CATALOG_JOBS_BASELINE=$(boxel_pg_psql -d "$PGDATABASE" -tAc 'SELECT COALESCE(max(id), 0) FROM jobs' 2>/dev/null)
  fi
  (
    for _ in $(seq 1 300); do
      if curl -skf "${CATALOG_REALM_URL}_readiness-check?acceptHeader=application%2Fvnd.api%2Bjson" >/dev/null 2>&1; then
        if [ -n "$CATALOG_JOBS_BASELINE" ] &&
          [ "$(boxel_pg_psql -d "$PGDATABASE" -tAc "SELECT EXISTS (SELECT 1 FROM jobs WHERE id > ${CATALOG_JOBS_BASELINE} AND job_type = 'from-scratch-index' AND concurrency_group = 'indexing:${CATALOG_REALM_URL}')" 2>/dev/null)" = "t" ]; then
          echo "catalog test subset: not touching the subset files; the catalog realm's boot index dropped their compiled modules"
        else
          node ../catalog/scripts/sync-test-subset.ts --touch="$CATALOG_TOUCH"
        fi
        exit 0
      fi
      sleep 2
    done
  ) &
fi

LOW_CREDIT_THRESHOLD="${LOW_CREDIT_THRESHOLD:-2000}" \
  NODE_ENV=development \
  NODE_NO_WARNINGS=1 \
  PGPORT="${PGPORT}" \
  PGDATABASE="${PGDATABASE}" \
  LOG_LEVELS="${LOG_LEVELS:-*=info}" \
  REALM_SERVER_SECRET_SEED="mum's the word" \
  REALM_SECRET_SEED="shhh! it's a secret" \
  GRAFANA_SECRET="shhh! it's a secret" \
  AI_BOT_DELEGATION_SECRET="shhh! it's a secret" \
  MATRIX_URL="${MATRIX_URL_VAL}" \
  REALM_SERVER_MATRIX_USERNAME=realm_server \
  ENABLE_FILE_WATCHER=true \
  node main.ts \
  --port="${REALM_PORT}" \
  --matrixURL="${MATRIX_URL_VAL}" \
  --realmsRootPath="${REALMS_ROOT}" \
  --prerendererUrl="${PRERENDER_MGR_URL}" \
  --migrateDB \
  $WORKER_MANAGER_ARG \
  \
  --path='../base' \
  --username='base_realm' \
  --fromUrl='https://cardstack.com/base/' \
  --toUrl="${REALM_BASE_URL}/base/" \
  \
  ${START_CATALOG:+--path="${CATALOG_PATH}"} \
  ${START_CATALOG:+--username='catalog_realm'} \
  ${START_CATALOG:+--fromUrl='@cardstack/catalog/'} \
  ${START_CATALOG:+--toUrl="${CATALOG_REALM_URL}"} \
  \
  --path='../skills-realm/contents' \
  --username='skills_realm' \
  --fromUrl='@cardstack/skills/' \
  --toUrl="${REALM_BASE_URL}/skills/" \
  \
  --path='../pretui' \
  --username='pretui_realm' \
  --fromUrl='@cardstack/pretui/' \
  --toUrl="${REALM_BASE_URL}/pretui/" \
  \
  ${START_SUBMISSION:+--path="${SUBMISSION_REALM_PATH}"} \
  ${START_SUBMISSION:+--username='submission_realm'} \
  ${START_SUBMISSION:+--fromUrl="${SUBMISSION_REALM_URL}"} \
  ${START_SUBMISSION:+--toUrl="${SUBMISSION_REALM_URL}"} \
  \
  ${START_BOXEL_HOMEPAGE:+--path='../boxel-homepage-realm/contents'} \
  ${START_BOXEL_HOMEPAGE:+--username='boxel_homepage_realm'} \
  ${START_BOXEL_HOMEPAGE:+--fromUrl="${BOXEL_HOMEPAGE_REALM_URL}"} \
  ${START_BOXEL_HOMEPAGE:+--toUrl="${BOXEL_HOMEPAGE_REALM_URL}"} \
  \
  ${START_EXPERIMENTS:+--path='../experiments-realm'} \
  ${START_EXPERIMENTS:+--username='experiments_realm'} \
  ${START_EXPERIMENTS:+--fromUrl="${REALM_BASE_URL}/experiments/"} \
  ${START_EXPERIMENTS:+--toUrl="${REALM_BASE_URL}/experiments/"} \
  \
  --path='../openrouter-realm' \
  --username='openrouter_realm' \
  --fromUrl='@cardstack/openrouter/' \
  --toUrl="${REALM_BASE_URL}/openrouter/" \
  \
  ${START_SOFTWARE_FACTORY:+--path='../software-factory/realm'} \
  ${START_SOFTWARE_FACTORY:+--username='software_factory_realm'} \
  ${START_SOFTWARE_FACTORY:+--fromUrl="${SOFTWARE_FACTORY_REALM_URL}"} \
  ${START_SOFTWARE_FACTORY:+--toUrl="${SOFTWARE_FACTORY_REALM_URL}"} \
  2>&1 | "$LOG_TEE" realm-server
