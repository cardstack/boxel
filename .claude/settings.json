{
  "permissions": {
    "allow": [
      "Bash(pnpm lint*)",
      "Bash(npx eslint *)",
      "Bash(aws --profile claude-staging *)",
      "Bash(pnpm exec eslint *)",
      "Bash(gh search *)",
      "Bash(gh run download *)",
      "Bash(mise tasks *)",
      "Bash(npx tsc *)",
      "Bash(node --check *)",
      "Bash(npx vitest run *)",
      "Bash(pnpm exec prettier *)",
      "mcp__Linear",
      "mcp__github__pull_request_read",
      "mcp__github__list_pull_requests",
      "mcp__github__get_file_contents",
      "mcp__github__search_code",
      "mcp__github__list_commits",
      "mcp__github__get_commit",
      "mcp__github__get_me",
      "mcp__github__actions_list",
      "mcp__github__actions_get",
      "mcp__github__get_job_logs",
      "mcp__chrome-devtools__take_screenshot"
    ]
  },
  "extraKnownMarketplaces": {
    "interfaces": {
      "source": {
        "source": "github",
        "repo": "jakubkrehel/skills"
      }
    },
    "cardstack-boxel": {
      "source": {
        "source": "github",
        "repo": "cardstack/boxel"
      }
    }
  },
  "enabledPlugins": {
    "interfaces@interfaces": true,
    "boxel-skills@cardstack-boxel": true
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|Bash|mcp__github__create_pull_request|mcp__github__update_pull_request|mcp__github__pull_request_review_write|mcp__github__add_comment_to_pending_review",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/require-skill.mjs\""
          }
        ]
      }
    ]
  }
}
