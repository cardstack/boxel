{
  "name": "cardstack-boxel",
  "interface": {
    "displayName": "Cardstack Boxel"
  },
  "plugins": [
    {
      "name": "boxel-cli",
      "source": {
        "source": "local",
        "path": "./packages/boxel-cli/plugin"
      },
      "description": "Skills for working with Boxel realms via @cardstack/boxel-cli.",
      "policy": {
        "installation": "AVAILABLE",
        "authentication": "ON_INSTALL",
        "products": ["CODEX"]
      },
      "category": "Developer Tools"
    },
    {
      "name": "boxel-skills",
      "source": {
        "source": "url",
        "url": "https://github.com/cardstack/boxel-skills.git",
        "ref": "v0.1.10"
      },
      "description": "Official Boxel card-building skills, from cardstack/boxel-skills. Install alongside boxel-cli.",
      "policy": {
        "installation": "AVAILABLE",
        "authentication": "ON_INSTALL",
        "products": ["CODEX"]
      },
      "category": "Developer Tools"
    }
  ]
}
