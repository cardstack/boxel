{
  "name": "choreo-gallery",
  "version": "0.0.0",
  "private": true,
  "engines": {
    "node": ">=22.16.0"
  },
  "description": "Generated Boxel adaptation of the canonical Choreo gallery.",
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./declarations/index.d.ts",
      "default": "./dist/index.js"
    },
    "./*": {
      "types": "./declarations/*.d.ts",
      "default": "./dist/*.js"
    },
    "./addon-main.js": "./addon-main.cjs"
  },
  "typesVersions": {
    "*": {
      "*": [
        "declarations/*",
        "declarations/*/index"
      ]
    }
  },
  "files": [
    "addon-main.cjs",
    "declarations",
    "dist",
    "public",
    "styles"
  ],
  "scripts": {
    "build": "node scripts/sync-gallery.mjs && node scripts/scope-css.mjs && rollup --config",
    "build:realm": "node scripts/build-boxel-realm.mjs",
    "lint:types": "glint --noEmit",
    "test:boxel": "node scripts/test-boxel-runtime.mjs",
    "test:realm": "node --test tests/realm-output.test.mjs",
    "test:theater-sizing": "node scripts/test-theater-sizing.mjs",
    "start": "node scripts/scope-css.mjs && rollup --config --watch"
  },
  "dependencies": {
    "@chenglou/pretext": "^0.0.8",
    "choreo-player": "workspace:*",
    "decorator-transforms": "^2.4.0",
    "dialkit": "^2.0.0",
    "ember-modifier": "^4.3.0",
    "glimmer-motion": "workspace:*",
    "motion": "^13.1.1",
    "motion-dom": "^13.1.1",
    "three": "^0.185.1",
    "three-149": "npm:three@0.149.0",
    "marked": "^18.0.11"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/plugin-transform-typescript": "^7.29.7",
    "@ember/library-tsconfig": "^1.1.3",
    "@embroider/addon-dev": "^7.1.0",
    "@embroider/addon-shim": "^1.8.9",
    "@glimmer/component": "^2.1.1",
    "@glimmer/tracking": "^1.1.2",
    "@glint/core": "2.0.1-unstable.ca49b21",
    "@glint/environment-ember-loose": "2.0.1-unstable.bd76fd7",
    "@glint/environment-ember-template-imports": "2.0.1-unstable.ca8146a",
    "@glint/template": "1.7.5-unstable.27a551c",
    "@rollup/plugin-babel": "^6.0.4",
    "@rollup/plugin-json": "6.1.0",
    "@types/three": "^0.185.4",
    "babel-plugin-ember-template-compilation": "^2.4.1",
    "ember-source": "~6.12.0",
    "esbuild": "^0.25.0",
    "glimmer-scoped-css": "^0.8.1",
    "playwright": "1.61.0",
    "postcss": "^8.5.6",
    "postcss-selector-parser": "^7.1.0",
    "rollup": "^4.59.0",
    "typescript": "^5.5.4"
  },
  "ember-addon": {
    "type": "addon",
    "version": 2,
    "main": "addon-main.cjs",
    "app-js": {}
  }
}
