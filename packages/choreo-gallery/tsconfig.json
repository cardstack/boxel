{
  "extends": "@ember/library-tsconfig",
  "include": ["src/**/*"],
  "compilerOptions": {
    "allowJs": true,
    "baseUrl": ".",
    "declaration": false,
    "declarationMap": false,
    "emitDeclarationOnly": false,
    "noEmit": true,
    "paths": {
      "choreo-gallery/*": ["src/*"],
      /**
        glimmer-motion, @cardstack/choreo and choreo-player resolve to their
        source, so type-checking needs none of them built. Their
        package.json#exports point types at the build output that npm
        consumers get.
      */
      "@cardstack/choreo": ["../choreo/src/index.ts"],
      "@cardstack/choreo/*": ["../choreo/src/*"],
      "glimmer-motion": ["../glimmer-motion/src/index.ts"],
      "glimmer-motion/*": ["../glimmer-motion/src/*"],
      "choreo-player": ["../choreo-player/src/index.ts"],
      "choreo-player/hyperframes": ["../choreo-player/src/hyperframes.ts"]
    },
    "types": ["ember-source/types"]
  }
}
