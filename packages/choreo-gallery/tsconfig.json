{
  "extends": "@ember/library-tsconfig",
  "include": ["src/**/*"],
  "compilerOptions": {
    "allowJs": true,
    "baseUrl": ".",
    "declaration": false,
    "declarationMap": false,
    "emitDeclarationOnly": false,
    "noEmit": true,
    "paths": {
      "choreo-gallery/*": ["src/*"],
      /**
        choreo-player resolves to its source, so type-checking needs it
        unbuilt. Its package.json#exports point types at the build output
        that npm consumers get.
      */
      "choreo-player": ["../choreo-player/src/index.ts"],
      "choreo-player/hyperframes": ["../choreo-player/src/hyperframes.ts"]
    },
    /**
      glimmer-motion and @cardstack/choreo resolve to their source through
      the `developing:choreo` export condition, so type-checking needs
      neither built.
    */
    "customConditions": ["developing:choreo"],
    "types": ["ember-source/types"]
  }
}
