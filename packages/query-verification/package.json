{
  "name": "@cardstack/query-verification",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./conformance": "./src/conformance.ts",
    "./known": "./src/known.ts",
    "./engine-fixture": "./src/engine-fixture.ts",
    "./sqlite-adapter": "./src/sqlite-adapter.ts"
  },
  "scripts": {
    "prove": "cd lean && lake build QueryV2 && out=$(lake env lean Audit.lean) && echo \"$out\" && ! echo \"$out\" | grep -q sorryAx",
    "vectors": "node src/build-vectors.ts",
    "vectors:check": "node src/build-vectors.ts --check",
    "test": "TZ=UTC node src/check-matcher.ts && TZ=America/New_York node src/check-matcher.ts && node src/check-grammar.ts && node src/check-sqlite.ts",
    "lint": "eslint . --report-unused-disable-directives --cache",
    "lint:fix": "eslint . --report-unused-disable-directives --fix"
  },
  "dependencies": {
    "@cardstack/runtime-common": "workspace:*"
  },
  "devDependencies": {
    "eslint": "catalog:"
  }
}
