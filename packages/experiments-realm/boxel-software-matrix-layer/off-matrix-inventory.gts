import {
  CardDef,
  Component,
  contains,
  field,
} from 'https://cardstack.com/base/card-api';
import StringField from 'https://cardstack.com/base/string';
import DateTimeField from 'https://cardstack.com/base/datetime';
import PackageSearchIcon from '@cardstack/boxel-icons/package-search';

// One entry per Spec in this realm that documents shipped code no matrix row
// claims. `apps` is import-graph reachability from each app root, so it says
// which delivered app the block is actually wired into — not which app it was
// filed under.
export interface OffMatrixEntry {
  slug: string;
  name: string;
  kind: string;
  apps: string[];
  consumers: number;
  readMe: number;
  example: boolean;
  gaps: string[];
}

export interface AppGroup {
  app: string;
  count: number;
  blocks: OffMatrixEntry[];
}

const GAP_LABEL: Record<string, string> = {
  example: 'no example',
  consumer: 'no consumer',
  // A command is reached by `new XCommand(...)` or as an assistant tool, so
  // "no call site" says what was actually looked for and did not find.
  callsite: 'no call site',
  reuse: 'one consumer only',
};

export function parseEntries(raw: string | undefined): OffMatrixEntry[] {
  try {
    let parsed = raw ? JSON.parse(raw) : [];
    if (!Array.isArray(parsed)) return [];
    return parsed.map((e: any) => ({
      slug: String(e?.slug ?? ''),
      name: String(e?.name ?? ''),
      kind: String(e?.kind ?? ''),
      apps: Array.isArray(e?.apps) ? e.apps.map(String) : [],
      consumers: Number(e?.consumers ?? 0),
      readMe: Number(e?.readMe ?? 0),
      example: Boolean(e?.example),
      gaps: Array.isArray(e?.gaps) ? e.gaps.map(String) : [],
    }));
  } catch {
    return [];
  }
}

// A block wired into two apps is counted under both — the question the panel
// answers is "which app would lose this", and the answer can be several.
export function groupByApp(entries: OffMatrixEntry[]): AppGroup[] {
  let map = new Map<string, OffMatrixEntry[]>();
  for (let e of entries) {
    let keys = e.apps.length ? e.apps : ['No app imports it'];
    for (let k of keys) {
      let list = map.get(k);
      if (list) {
        list.push(e);
      } else {
        map.set(k, [e]);
      }
    }
  }
  return [...map.entries()]
    .map(([app, blocks]) => ({ app, count: blocks.length, blocks }))
    .sort((a, b) => b.count - a.count || a.app.localeCompare(b.app));
}

export function gapLabels(gaps: string[]): string {
  let named = gaps.map((g) => GAP_LABEL[g] ?? g);
  return named.length ? named.join(' · ') : 'complete';
}

export class OffMatrixInventory extends CardDef {
  static displayName = 'Off-Matrix Inventory';
  static icon = PackageSearchIcon;

  @field roundDate = contains(DateTimeField);
  // JSON array of OffMatrixEntry, regenerated by `matrix-crawl.py --inventory`.
  @field blocks = contains(StringField);

  @field cardTitle = contains(StringField, {
    computeVia: function (this: OffMatrixInventory) {
      let d = this.roundDate;
      return d
        ? `Shipped outside the matrix — ${d.toISOString().slice(0, 10)}`
        : 'Shipped outside the matrix';
    },
  });

  get entries(): OffMatrixEntry[] {
    return parseEntries(this.blocks);
  }

  static embedded = class Embedded extends Component<
    typeof OffMatrixInventory
  > {
    get entries() {
      return parseEntries((this.args.model as OffMatrixInventory)?.blocks);
    }
    get groups() {
      return groupByApp(this.entries).slice(0, 6);
    }

    <template>
      <div class='inv-row'>
        <div class='head'>
          <span class='count'>{{this.entries.length}}</span>
          <span class='label'>shipped blocks with no matrix row</span>
        </div>
        <div class='chips'>
          {{#each this.groups as |g|}}
            <span class='chip'>{{g.app}}
              <span class='chip-n'>{{g.count}}</span></span>
          {{/each}}
        </div>
      </div>
      <style scoped>
        .inv-row {
          display: flex;
          flex-direction: column;
          gap: 0.5rem;
          padding: 0.625rem 0.875rem;
        }
        .head {
          display: flex;
          align-items: baseline;
          gap: 0.375rem;
        }
        .count {
          font-size: 1.25rem;
          font-weight: 700;
          font-variant-numeric: tabular-nums;
        }
        .label {
          font-size: 0.8125rem;
          color: var(--muted-foreground, #6b7280);
        }
        .chips {
          display: flex;
          flex-wrap: wrap;
          gap: 0.25rem;
        }
        .chip {
          font-size: 0.6875rem;
          font-weight: 600;
          padding: 0.125rem 0.4375rem;
          border-radius: 999px;
          background: var(--muted, #f3f4f6);
          color: var(--foreground, #111827);
        }
        .chip-n {
          font-variant-numeric: tabular-nums;
          opacity: 0.6;
        }
      </style>
    </template>
  };

  static isolated = class Isolated extends Component<
    typeof OffMatrixInventory
  > {
    get entries() {
      return parseEntries((this.args.model as OffMatrixInventory)?.blocks);
    }
    get groups() {
      return groupByApp(this.entries);
    }
    get withGaps() {
      return this.entries.filter((e) => e.gaps.length);
    }
    get reusedCount() {
      return this.entries.filter((e) => e.consumers >= 2).length;
    }

    <template>
      <article class='inv-page'>
        <header class='ih'>
          <p class='doc-kind'>Shipped, not in the matrix</p>
          <h1><@fields.roundDate /></h1>
          <p class='lede'>{{this.entries.length}}
            Specs in this realm document working code that no matrix concept
            claims. Each was built to finish an app, so the code is real and
            in use — the taxonomy simply has no row for it. Deciding which
            deserve a row is the planning question; nothing here is a defect.</p>
        </header>

        <section class='stats'>
          <div class='stat'>
            <span class='sv'>{{this.entries.length}}</span>
            <span class='sl'>blocks</span>
          </div>
          <div class='stat'>
            <span class='sv'>{{this.reusedCount}}</span>
            <span class='sl'>used by two or more modules</span>
          </div>
          <div class='stat'>
            <span class='sv'>{{this.withGaps.length}}</span>
            <span class='sl'>with a quality gap</span>
          </div>
        </section>

        {{#each this.groups as |g|}}
          <section class='group'>
            <h2>{{g.app}}<span class='gn'>{{g.count}}</span></h2>
            <table>
              <thead>
                <tr>
                  <th>Block</th>
                  <th>Kind</th>
                  <th class='num'>Consumers</th>
                  <th>Gap</th>
                </tr>
              </thead>
              <tbody>
                {{#each g.blocks as |b|}}
                  <tr>
                    <td class='bn'>{{b.name}}</td>
                    <td><span class='kind'>{{b.kind}}</span></td>
                    <td class='num'>{{b.consumers}}</td>
                    <td
                      class='gap {{if b.gaps.length "has-gap"}}'
                    >{{gapLabels b.gaps}}</td>
                  </tr>
                {{/each}}
              </tbody>
            </table>
          </section>
        {{/each}}
      </article>
      <style scoped>
        .inv-page {
          padding: 1.5rem;
          max-width: 60rem;
          margin: 0 auto;
          font-size: 0.875rem;
          color: var(--foreground, #111827);
        }
        .doc-kind {
          margin: 0;
          font-size: 0.6875rem;
          font-weight: 700;
          letter-spacing: 0.08em;
          text-transform: uppercase;
          color: var(--muted-foreground, #6b7280);
        }
        h1 {
          margin: 0.25rem 0 0.5rem;
          font-size: 1.375rem;
        }
        .lede {
          margin: 0;
          max-width: 46rem;
          line-height: 1.55;
          color: var(--muted-foreground, #6b7280);
        }
        .stats {
          display: flex;
          gap: 1.5rem;
          margin: 1.25rem 0 0.5rem;
          padding: 0.875rem 0;
          border-top: 1px solid var(--border, #e5e7eb);
          border-bottom: 1px solid var(--border, #e5e7eb);
        }
        .stat {
          display: flex;
          flex-direction: column;
        }
        .sv {
          font-size: 1.5rem;
          font-weight: 700;
          font-variant-numeric: tabular-nums;
          line-height: 1.1;
        }
        .sl {
          font-size: 0.75rem;
          color: var(--muted-foreground, #6b7280);
        }
        .group {
          margin-top: 1.5rem;
        }
        .group h2 {
          display: flex;
          align-items: center;
          gap: 0.5rem;
          margin: 0 0 0.5rem;
          font-size: 0.9375rem;
        }
        .gn {
          font-size: 0.6875rem;
          font-weight: 700;
          font-variant-numeric: tabular-nums;
          padding: 0.0625rem 0.375rem;
          border-radius: 999px;
          background: var(--muted, #f3f4f6);
          color: var(--muted-foreground, #6b7280);
        }
        table {
          width: 100%;
          border-collapse: collapse;
        }
        th {
          text-align: left;
          font-size: 0.6875rem;
          font-weight: 700;
          letter-spacing: 0.04em;
          text-transform: uppercase;
          color: var(--muted-foreground, #6b7280);
          padding: 0.25rem 0.5rem 0.25rem 0;
          border-bottom: 1px solid var(--border, #e5e7eb);
        }
        td {
          padding: 0.3125rem 0.5rem 0.3125rem 0;
          border-bottom: 1px solid var(--border-subtle, #f3f4f6);
          vertical-align: baseline;
        }
        .num {
          text-align: right;
          font-variant-numeric: tabular-nums;
          padding-right: 1rem;
        }
        .bn {
          font-weight: 600;
        }
        .kind {
          font-size: 0.6875rem;
          padding: 0.0625rem 0.375rem;
          border-radius: 0.25rem;
          background: var(--muted, #f3f4f6);
          color: var(--muted-foreground, #6b7280);
        }
        .gap {
          font-size: 0.75rem;
          color: var(--muted-foreground, #9ca3af);
        }
        .gap.has-gap {
          color: var(--state-next-fg, #92400e);
        }
      </style>
    </template>
  };
}
