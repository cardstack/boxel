{
  "name": "@cardstack/pretui",
  "version": "0.0.0",
  "private": true,
  "description": "Pret UI component kit. Served by the realm-server as the realm @cardstack/pretui/ and consumed by the host as a workspace dependency; both resolve the same source through package.json#exports.",
  "license": "MIT",
  "scripts": {
    "lint": "concurrently \"pnpm:lint:*(!fix)\" --names \"lint:\"",
    "lint:hbs": "ember-template-lint .",
    "lint:hbs:fix": "ember-template-lint . --fix",
    "lint:types": "ember-tsc --noEmit"
  },
  "dependencies": {
    "ember-modifier": "catalog:"
  },
  "devDependencies": {
    "@cardstack/boxel-icons": "workspace:*",
    "@cardstack/boxel-ui": "workspace:*",
    "@cardstack/local-types": "workspace:*",
    "@ember/test-helpers": "catalog:",
    "@glimmer/component": "catalog:",
    "@glimmer/tracking": "^1.0.4",
    "@glint/ember-tsc": "catalog:",
    "@glint/template": "catalog:",
    "@types/qunit": "catalog:",
    "concurrently": "catalog:",
    "ember-source": "catalog:",
    "ember-template-lint": "catalog:",
    "qunit": "catalog:",
    "qunit-dom": "catalog:",
    "typescript": "catalog:"
  },
  "peerDependencies": {
    "ember-source": "catalog:"
  },
  "exports": {
    "./*": "./*.gts"
  }
}
