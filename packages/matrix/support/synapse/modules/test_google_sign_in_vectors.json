{
  "description": "How a Google identity with no linked account resolves to a Matrix account. Run against BoxelOidcMappingProvider (test_boxel_oidc_mapping_provider.py) and the realm server's secure-origin Google sign-in (packages/realm-server/tests/google-account-test.ts), so the two can't diverge. `usersByEmail` lists the accounts holding the email; `existingLocalparts` the localparts already taken. `expected.outcome` is `existing` (the Google identity is linked to that account), `new` (an account is made) or `refused` (with the message the user sees).",
  "vectors": [
    {
      "name": "a missing email is refused",
      "userinfo": { "sub": "g-1", "email_verified": true, "name": "Alice" },
      "usersByEmail": [],
      "existingLocalparts": [],
      "expected": {
        "outcome": "refused",
        "message": "Google sign-in requires a verified email address."
      }
    },
    {
      "name": "an unverified email is refused",
      "userinfo": {
        "sub": "g-1",
        "email": "alice@gmail.com",
        "email_verified": false,
        "name": "Alice"
      },
      "usersByEmail": [],
      "existingLocalparts": [],
      "expected": {
        "outcome": "refused",
        "message": "Google sign-in requires a verified email address."
      }
    },
    {
      "name": "an email verified only as a string is refused",
      "userinfo": {
        "sub": "g-1",
        "email": "alice@gmail.com",
        "email_verified": "true",
        "name": "Alice"
      },
      "usersByEmail": [],
      "existingLocalparts": [],
      "expected": {
        "outcome": "refused",
        "message": "Google sign-in requires a verified email address."
      }
    },
    {
      "name": "the one account holding the email is linked",
      "userinfo": {
        "sub": "g-1",
        "email": "Alice@Gmail.com",
        "email_verified": true,
        "name": "Alice"
      },
      "usersByEmail": ["@existing:localhost"],
      "existingLocalparts": ["existing", "alice"],
      "expected": {
        "outcome": "existing",
        "localpart": "existing",
        "displayName": "Alice",
        "email": "alice@gmail.com"
      }
    },
    {
      "name": "two accounts holding the email are refused",
      "userinfo": {
        "sub": "g-1",
        "email": "alice@gmail.com",
        "email_verified": true,
        "name": "Alice"
      },
      "usersByEmail": ["@one:localhost", "@two:localhost"],
      "existingLocalparts": ["one", "two"],
      "expected": {
        "outcome": "refused",
        "message": "Multiple Matrix accounts already use this email address; please contact support to resolve before signing in with Google."
      }
    },
    {
      "name": "a new account takes the email's local part",
      "userinfo": {
        "sub": "g-1",
        "email": "alice@gmail.com",
        "email_verified": true,
        "name": "Alice Example"
      },
      "usersByEmail": [],
      "existingLocalparts": [],
      "expected": {
        "outcome": "new",
        "localpart": "alice",
        "displayName": "Alice Example",
        "email": "alice@gmail.com"
      }
    },
    {
      "name": "a new account lowercases the email",
      "userinfo": {
        "sub": "g-1",
        "email": " Alice.Smith@Example.COM ",
        "email_verified": true,
        "name": "Alice"
      },
      "usersByEmail": [],
      "existingLocalparts": [],
      "expected": {
        "outcome": "new",
        "localpart": "alice.smith",
        "displayName": "Alice",
        "email": "alice.smith@example.com"
      }
    },
    {
      "name": "a new account replaces characters Matrix forbids",
      "userinfo": {
        "sub": "g-1",
        "email": "O'Brien!x#y@gmail.com",
        "email_verified": true,
        "name": "Pat"
      },
      "usersByEmail": [],
      "existingLocalparts": [],
      "expected": {
        "outcome": "new",
        "localpart": "o-brien-x-y",
        "displayName": "Pat",
        "email": "o'brien!x#y@gmail.com"
      }
    },
    {
      "name": "a new account keeps the characters Matrix allows",
      "userinfo": {
        "sub": "g-1",
        "email": "a.b_c=d-e/f+g@gmail.com",
        "email_verified": true,
        "name": "Pat"
      },
      "usersByEmail": [],
      "existingLocalparts": [],
      "expected": {
        "outcome": "new",
        "localpart": "a.b_c=d-e/f+g",
        "displayName": "Pat",
        "email": "a.b_c=d-e/f+g@gmail.com"
      }
    },
    {
      "name": "a local part of only forbidden characters becomes user",
      "userinfo": {
        "sub": "g-1",
        "email": "!!!@gmail.com",
        "email_verified": true,
        "name": "Pat"
      },
      "usersByEmail": [],
      "existingLocalparts": [],
      "expected": {
        "outcome": "new",
        "localpart": "user",
        "displayName": "Pat",
        "email": "!!!@gmail.com"
      }
    },
    {
      "name": "a new account is never linked into an account that merely has its localpart",
      "userinfo": {
        "sub": "g-1",
        "email": "alice@gmail.com",
        "email_verified": true,
        "name": "Alice"
      },
      "usersByEmail": [],
      "existingLocalparts": ["alice"],
      "expected": {
        "outcome": "new",
        "localpart": "alice1",
        "displayName": "Alice",
        "email": "alice@gmail.com"
      }
    },
    {
      "name": "a new account suffixes past a run of taken localparts",
      "userinfo": {
        "sub": "g-1",
        "email": "alice@gmail.com",
        "email_verified": true,
        "name": "Alice"
      },
      "usersByEmail": [],
      "existingLocalparts": ["alice", "alice1", "alice2"],
      "expected": {
        "outcome": "new",
        "localpart": "alice3",
        "displayName": "Alice",
        "email": "alice@gmail.com"
      }
    },
    {
      "name": "a new account with no Google name has no display name",
      "userinfo": {
        "sub": "g-1",
        "email": "alice@gmail.com",
        "email_verified": true
      },
      "usersByEmail": [],
      "existingLocalparts": [],
      "expected": {
        "outcome": "new",
        "localpart": "alice",
        "displayName": null,
        "email": "alice@gmail.com"
      }
    }
  ]
}
