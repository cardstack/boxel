{
  "name": "@cardstack/bxl",
  "version": "0.2.0",
  "description": "Boxel Expression Language: readable syntax, linter, formatter, and sandboxed evaluator that compiles to jqxl v1.",
  "keywords": [
    "bxl",
    "boxel",
    "jq",
    "jqxl",
    "expression-language",
    "formula",
    "spreadsheet"
  ],
  "license": "MIT",
  "author": "Cardstack",
  "homepage": "https://github.com/cardstack/bxl",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cardstack/bxl.git"
  },
  "bugs": {
    "url": "https://github.com/cardstack/bxl/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=18.17"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./compiler": {
      "types": "./dist/compiler.d.ts",
      "import": "./dist/compiler.js"
    },
    "./linter": {
      "types": "./dist/linter.d.ts",
      "import": "./dist/linter.js"
    },
    "./runtime": {
      "types": "./dist/runtime.d.ts",
      "import": "./dist/runtime.js"
    },
    "./boxel-runtime": {
      "types": "./dist/boxel-runtime.d.ts",
      "import": "./dist/boxel-runtime.js"
    },
    "./runtime-bare": {
      "types": "./dist/runtime-bare.d.ts",
      "import": "./dist/runtime-bare.js"
    },
    "./syntax/textmate": "./dist/syntax/bxl.tmLanguage.json",
    "./examples": {
      "types": "./dist/examples/index.d.ts",
      "import": "./dist/examples/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "bxl": "./dist/cli.js",
    "bxl-sync": "./scripts/bxl-sync.mjs"
  },
  "files": [
    "dist",
    "docs",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "NOTICE.md",
    "SECURITY.md"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "clean": "rm -rf dist",
    "perf:build": "node scripts/perf-browser.mjs",
    "perf:browser": "node scripts/perf-browser.mjs --serve",
    "demo:realm-collaboration": "node scripts/perf-browser.mjs --serve --corpus",
    "perf:computed": "node scripts/run-ts-entry.mjs scripts/bench-boxel-computed.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests examples",
    "test": "node scripts/run-tests.mjs",
    "test:smoke": "node scripts/run-ts-entry.mjs tests/smoke/bxl-smoke.ts",
    "test:boxel": "node scripts/run-tests.mjs tests/boxel",
    "test:computed-equivalence": "node scripts/run-ts-entry.mjs scripts/verify-boxel-computed-equivalence.ts",
    "audit:realm-bxl": "node scripts/run-ts-entry.mjs scripts/audit-realm-bxl.ts",
    "test:size": "node scripts/size-report.mjs --check",
    "realm": "node scripts/build-realm-bundle.mjs",
    "realm:local": "node scripts/build-realm-bundle.mjs --no-sync",
    "realm:sync": "node scripts/bxl-sync.mjs",
    "docs:api": "typedoc",
    "prepack": "npm run clean && npm run build",
    "release:dry": "npm pack --dry-run"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/node": "^20.11.0",
    "esbuild": "^0.20.0",
    "eslint": "^9.0.0",
    "happy-dom": "^14.0.0",
    "tsx": "^4.7.0",
    "typedoc": "^0.25.0",
    "typescript": "^5.4.0",
    "typescript-eslint": "^8.59.0"
  },
  "dependencies": {
    "bessel": "^1.0.2",
    "jstat": "^1.9.6",
    "validator": "^13.15.35"
  }
}
