{
  "extends": "@ember/app-tsconfig",
  "include": ["app", "tests", "types", "vendor"],
  "compilerOptions": {
    "allowJs": true,
    "noEmitOnError": false,
    "declaration": false,
    "declarationMap": false,
    "allowImportingTsExtensions": true,
    "paths": {
      "choreo-film-app/tests/*": ["./tests/*"],
      "choreo-film-app/*": ["./app/*"],
      "*": ["./types/*"]
    },
    /**
      glimmer-motion and @cardstack/choreo resolve to their source through
      the `developing:choreo` export condition, so type-checking needs
      neither built.
    */
    "customConditions": ["developing:choreo"],
    "types": ["ember-source/types"]
  }
}
