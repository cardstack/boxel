{
  "name": "@cardstack/choreo",
  "version": "0.1.0-unstable.0",
  "description": "Motion, Choreographed. A changeset and a timeline over a whole render pass, on glimmer-motion.",
  "keywords": [
    "ember-addon",
    "animation",
    "choreography",
    "motion",
    "glimmer",
    "transition",
    "timeline"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/cardstack/boxel.git",
    "directory": "packages/choreo"
  },
  "license": "MIT",
  "author": "Cardstack",
  "exports": {
    ".": {
      "developing:choreo": "./src/index.ts",
      "types": "./declarations/index.d.ts",
      "default": "./dist/index.js"
    },
    "./test-support": {
      "developing:choreo": "./src/test-support/index.ts",
      "types": "./declarations/test-support/index.d.ts",
      "default": "./dist/test-support/index.js"
    },
    "./choreo": {
      "developing:choreo": "./src/choreo.gts",
      "types": "./declarations/choreo.d.ts",
      "default": "./dist/choreo.js"
    },
    "./film/clip": {
      "developing:choreo": "./src/film/clip.gts",
      "types": "./declarations/film/clip.d.ts",
      "default": "./dist/film/clip.js"
    },
    "./film/film": {
      "developing:choreo": "./src/film/film.gts",
      "types": "./declarations/film/film.d.ts",
      "default": "./dist/film/film.js"
    },
    "./film/graph/adjust": {
      "developing:choreo": "./src/film/graph/adjust.gts",
      "types": "./declarations/film/graph/adjust.d.ts",
      "default": "./dist/film/graph/adjust.js"
    },
    "./film/graph/host": {
      "developing:choreo": "./src/film/graph/host.gts",
      "types": "./declarations/film/graph/host.d.ts",
      "default": "./dist/film/graph/host.js"
    },
    "./film/graph/nodes": {
      "developing:choreo": "./src/film/graph/nodes.gts",
      "types": "./declarations/film/graph/nodes.d.ts",
      "default": "./dist/film/graph/nodes.js"
    },
    "./film/joins": {
      "developing:choreo": "./src/film/joins.gts",
      "types": "./declarations/film/joins.d.ts",
      "default": "./dist/film/joins.js"
    },
    "./film/overlays": {
      "developing:choreo": "./src/film/overlays.gts",
      "types": "./declarations/film/overlays.d.ts",
      "default": "./dist/film/overlays.js"
    },
    "./film/picture": {
      "developing:choreo": "./src/film/picture.gts",
      "types": "./declarations/film/picture.d.ts",
      "default": "./dist/film/picture.js"
    },
    "./film/plate": {
      "developing:choreo": "./src/film/plate.gts",
      "types": "./declarations/film/plate.d.ts",
      "default": "./dist/film/plate.js"
    },
    "./film/player": {
      "developing:choreo": "./src/film/player.gts",
      "types": "./declarations/film/player.d.ts",
      "default": "./dist/film/player.js"
    },
    "./film/rail": {
      "developing:choreo": "./src/film/rail.gts",
      "types": "./declarations/film/rail.d.ts",
      "default": "./dist/film/rail.js"
    },
    "./film/titles": {
      "developing:choreo": "./src/film/titles.gts",
      "types": "./declarations/film/titles.d.ts",
      "default": "./dist/film/titles.js"
    },
    "./steps": {
      "developing:choreo": "./src/steps.gts",
      "types": "./declarations/steps.d.ts",
      "default": "./dist/steps.js"
    },
    "./*": {
      "developing:choreo": "./src/*.ts",
      "types": "./declarations/*.d.ts",
      "default": "./dist/*.js"
    },
    "./addon-main.js": "./addon-main.cjs"
  },
  "typesVersions": {
    "*": {
      "*": [
        "declarations/*",
        "declarations/*/index"
      ]
    }
  },
  "files": [
    "addon-main.cjs",
    "declarations",
    "dist",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rollup --config && node scripts/fix-declarations.mjs",
    "check:packed-exports": "node ../glimmer-motion/scripts/check-exports.mjs --packed",
    "format": "prettier . --cache --write",
    "lint": "concurrently \"pnpm:lint:*(!fix)\" --names \"lint:\" --prefixColors auto",
    "lint:fix": "concurrently \"pnpm:lint:*:fix\" --names \"fix:\" --prefixColors auto && pnpm run format",
    "lint:format": "prettier . --cache --check",
    "lint:hbs": "ember-template-lint .",
    "lint:hbs:fix": "ember-template-lint . --fix",
    "lint:js": "eslint . --cache",
    "lint:js:fix": "eslint . --fix",
    "lint:exports": "node ../glimmer-motion/scripts/check-exports.mjs --source",
    "lint:types": "ember-tsc --noEmit",
    "prepack": "rollup --config && node scripts/fix-declarations.mjs",
    "start": "rollup --config --watch",
    "test": "vite build --mode=development --out-dir dist-tests && testem --file testem.cjs ci --port 0",
    "start:test": "vite dev --open /tests/"
  },
  "dependencies": {
    "@embroider/addon-shim": "^1.8.9",
    "decorator-transforms": "catalog:"
  },
  "devDependencies": {
    "@babel/core": "catalog:",
    "@babel/plugin-transform-runtime": "^7.29.0",
    "@babel/plugin-transform-typescript": "catalog:",
    "@babel/runtime": "catalog:",
    "@cardstack/choreo-eslint-config": "workspace:*",
    "@ember/library-tsconfig": "^1.1.3",
    "@ember/test-helpers": "^4.0.5",
    "@embroider/addon-dev": "^8.0.0",
    "@embroider/config-meta-loader": "^1.0.0",
    "@embroider/core": "^4.6.3",
    "@embroider/macros": "^1.20.2",
    "@embroider/vite": "^1.7.10",
    "@glimmer/component": "catalog:",
    "@glimmer/tracking": "^1.1.2",
    "@glimmer/validator": "^0.95.0",
    "@glint/ember-tsc": "catalog:",
    "@glint/template": "catalog:",
    "@rollup/plugin-babel": "catalog:",
    "@types/qunit": "catalog:",
    "babel-plugin-ember-template-compilation": "catalog:",
    "concurrently": "catalog:",
    "ember-modifier": "^4.3.0",
    "ember-qunit": "catalog:",
    "ember-source": "catalog:",
    "ember-strict-application-resolver": "^0.1.0",
    "ember-template-lint": "catalog:",
    "eslint": "^9.39.4",
    "glimmer-motion": "workspace:*",
    "motion-dom": "catalog:",
    "motion-utils": "catalog:",
    "prettier": "catalog:",
    "prettier-plugin-ember-template-tag": "catalog:",
    "qunit": "catalog:",
    "qunit-dom": "catalog:",
    "rollup": "catalog:",
    "testem": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:"
  },
  "peerDependenciesMeta": {
    "@ember/test-helpers": {
      "optional": true
    }
  },
  "ember-addon": {
    "version": 2,
    "type": "addon",
    "main": "addon-main.cjs",
    "app-js": {}
  },
  "peerDependencies": {
    "@ember/test-helpers": ">=3.0.0",
    "@glimmer/component": "^2.0.0",
    "ember-modifier": "^4.3.0",
    "ember-source": ">=5.4.0",
    "glimmer-motion": "workspace:*",
    "motion-dom": "^13.4.5",
    "motion-utils": "^13.3.0"
  }
}
