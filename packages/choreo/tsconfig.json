{
  "extends": "@ember/library-tsconfig",
  "include": ["src/**/*", "unpublished-development-types/**/*"],
  "compilerOptions": {
    "allowJs": true,
    /**
      glimmer-motion resolves to its source through the `developing:choreo`
      export condition, so type-checking needs it unbuilt. The declarations
      build (tsconfig.declarations.json) leaves the condition out and resolves
      it the way npm consumers do, so the emitted declarations import
      `glimmer-motion` rather than its source.
    */
    "customConditions": ["developing:choreo"],
    "types": ["ember-source/types"]
  }
}
