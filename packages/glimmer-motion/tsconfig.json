{
  "extends": "@ember/library-tsconfig",
  "include": ["src/**/*", "tests/**/*", "unpublished-development-types/**/*"],
  "compilerOptions": {
    "allowJs": true,
    /**
      The test harness imports glimmer-motion by its public specifiers, and
      those resolve to the source, so type-checking needs nothing built. The
      declarations build (tsconfig.declarations.json) covers `src` alone.
    */
    "paths": {
      "glimmer-motion": ["./src/index.ts"],
      "glimmer-motion/*": ["./src/*"]
    },
    "types": ["ember-source/types"]
  }
}
