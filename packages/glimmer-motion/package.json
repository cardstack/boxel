{
  "name": "glimmer-motion",
  "version": "0.0.0",
  "description": "The Motion engine for Ember: Motion's React glue re-done for Glimmer, on the unchanged motion-dom engine.",
  "keywords": [
    "ember-addon",
    "animation",
    "motion",
    "glimmer",
    "transition",
    "layout-animation",
    "gesture",
    "drag"
  ],
  "repository": "https://github.com/cardstack/choreo",
  "license": "MIT",
  "author": "Cardstack",
  "exports": {
    ".": {
      "types": "./declarations/index.d.ts",
      "default": "./dist/index.js"
    },
    "./test-support": {
      "types": "./declarations/test-support/index.d.ts",
      "default": "./dist/test-support/index.js"
    },
    "./*": {
      "types": "./declarations/*.d.ts",
      "default": "./dist/*.js"
    },
    "./addon-main.js": "./addon-main.cjs"
  },
  "typesVersions": {
    "*": {
      "*": [
        "declarations/*",
        "declarations/*/index"
      ]
    }
  },
  "files": [
    "addon-main.cjs",
    "declarations",
    "dist",
    "VENDORED.md"
  ],
  "scripts": {
    "build": "rollup --config && node scripts/fix-declarations.mjs",
    "format": "prettier . --cache --write",
    "lint": "concurrently \"pnpm:lint:*(!fix)\" --names \"lint:\" --prefixColors auto",
    "lint:fix": "concurrently \"pnpm:lint:*:fix\" --names \"fix:\" --prefixColors auto && pnpm run format",
    "lint:format": "prettier . --cache --check",
    "lint:hbs": "ember-template-lint .",
    "lint:hbs:fix": "ember-template-lint . --fix",
    "lint:js": "eslint . --cache",
    "lint:js:fix": "eslint . --fix",
    "lint:types": "ember-tsc --noEmit",
    "prepack": "rollup --config && node scripts/fix-declarations.mjs",
    "realm": "node scripts/build-realm-bundle.mjs",
    "realm:local": "node scripts/build-realm-bundle.mjs --no-sync",
    "realm:stage": "node scripts/build-realm-bundle.mjs --no-mirror",
    "start": "rollup --config --watch",
    "test": "vite build --mode=development --out-dir dist-tests && testem --file testem.cjs ci --port 0",
    "start:test": "vite dev --open /tests/"
  },
  "dependencies": {
    "@embroider/addon-shim": "^1.8.9",
    "decorator-transforms": "catalog:",
    "framer-motion": "catalog:"
  },
  "devDependencies": {
    "@babel/core": "catalog:",
    "@babel/plugin-transform-runtime": "^7.29.0",
    "@babel/plugin-transform-typescript": "catalog:",
    "@babel/runtime": "catalog:",
    "@cardstack/choreo-eslint-config": "workspace:*",
    "@ember/library-tsconfig": "^1.1.3",
    "@ember/test-helpers": "catalog:",
    "@embroider/addon-dev": "^8.0.0",
    "@embroider/config-meta-loader": "^1.0.0",
    "@embroider/core": "^4.6.3",
    "@embroider/macros": "^1.20.2",
    "@embroider/vite": "^1.7.10",
    "@glimmer/component": "catalog:",
    "@glimmer/tracking": "^1.1.2",
    "@glimmer/validator": "^0.95.0",
    "@glint/ember-tsc": "catalog:",
    "@glint/template": "catalog:",
    "@rollup/plugin-babel": "catalog:",
    "@types/qunit": "catalog:",
    "babel-plugin-ember-template-compilation": "catalog:",
    "concurrently": "catalog:",
    "ember-modifier": "^4.3.0",
    "ember-qunit": "catalog:",
    "ember-source": "catalog:",
    "ember-strict-application-resolver": "^0.1.0",
    "ember-template-lint": "catalog:",
    "esbuild": "^0.25.0",
    "eslint": "^9.39.4",
    "motion": "catalog:",
    "motion-dom": "catalog:",
    "motion-utils": "catalog:",
    "prettier": "catalog:",
    "prettier-plugin-ember-template-tag": "catalog:",
    "qunit": "catalog:",
    "qunit-dom": "catalog:",
    "rollup": "catalog:",
    "testem": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:"
  },
  "peerDependenciesMeta": {
    "@ember/test-helpers": {
      "optional": true
    }
  },
  "ember-addon": {
    "version": 2,
    "type": "addon",
    "main": "addon-main.cjs",
    "app-js": {}
  },
  "peerDependencies": {
    "@ember/test-helpers": ">=3.0.0",
    "@glimmer/component": "^2.0.0",
    "@glimmer/tracking": "^1.1.2",
    "ember-modifier": "^4.3.0",
    "ember-source": ">=5.4.0",
    "motion-dom": "^13.4.5",
    "motion-utils": "^13.3.0"
  }
}
