            "queryType": "instant"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "custom": {},
            "unit": "s"
          },
          "overrides": [
            {
              "matcher": {
                "id": "byName",
                "options": "job"
              },
              "properties": [
                {
                  "id": "links",
                  "value": [
