      {
        "datasource": {
          "type": "grafana-postgresql-datasource",
          "uid": "cef5v5sl9k7i8f"
        },
        "description": "Grants that are not ended, not expired, and not covered by a revocation of their user's grants, by client. Read from oauth_provider_grants now, whatever the time range.",
        "fieldConfig": {
          "defaults": {},
          "overrides": []
        },
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 0,
          "y": 40
        },
        "id": 20,
        "options": {
          "cellHeight": "sm",
          "showHeader": true,
          "footer": {
            "show": false
          }
        },
        "pluginVersion": "12.4.3",
        "targets": [
          {
            "datasource": {
              "type": "grafana-postgresql-datasource",
              "uid": "cef5v5sl9k7i8f"
            },
            "editorMode": "code",
            "format": "table",
            "rawQuery": true,
            "rawSql": "SELECT g.client_id AS client,\n       COUNT(*) AS active,\n       COUNT(*) FILTER (WHERE g.renewing) AS renewing,\n       COUNT(DISTINCT g.user_id) AS users\n  FROM oauth_provider_grants g\n  JOIN users u ON u.id = g.user_id\n WHERE g.ended_at IS NULL\n   AND g.expires_at > now()\n   AND (u.oauth_grants_revoked_at IS NULL OR g.created_at > u.oauth_grants_revoked_at)\n GROUP BY g.client_id\n ORDER BY active DESC;",
            "refId": "A"
          }
        ],
        "title": "Active grants by client",
        "type": "table"
      },
