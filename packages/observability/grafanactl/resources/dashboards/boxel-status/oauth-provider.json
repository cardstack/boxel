            "rawQuery": true,
            "rawSql": "SELECT date_trunc('day', created_at) AS time,\n       client_id AS metric,\n       COUNT(*) AS grants\n  FROM oauth_provider_grants\n WHERE $__timeFilter(created_at)\n GROUP BY 1, 2\n ORDER BY 1;",
