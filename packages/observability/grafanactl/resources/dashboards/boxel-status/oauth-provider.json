        "pluginVersion": "12.4.3",
        "targets": [
          {
            "datasource": {
              "type": "loki",
              "uid": "loki"
            },
            "editorMode": "code",
            "expr": "sum (count_over_time({service=\"realm-server\", env=\"$env\"} |= \"boxel:oauth-provider\" | json | drop __error__, __error_details__ | line_format `{{ if .log }}{{ regexReplaceAll \"^\\\\[worker [^\\\\]]+\\\\]: \" .log \"\" }}{{ else }}{{ regexReplaceAll \"^\\\\[worker [^\\\\]]+\\\\]: \" __line__ \"\" }}{{ end }}` | json | channel=\"boxel:oauth-provider\" | event=\"reuse\" [$__range])) or vector(0)",
