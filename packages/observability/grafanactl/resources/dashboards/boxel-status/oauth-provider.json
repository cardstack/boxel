    "description": "Boxel as an OAuth provider: connections made and ended, consents, refusals by reason, the signs of misuse the oauth-provider-group alerts fire on, and active grants by client. Built on the JSON events of the boxel:oauth-provider channel and the oauth_provider_grants table. The oauth-provider skill reads it.",
    "editable": true,
    "fiscalYearStartMonth": 0,
    "graphTooltip": 1,
    "links": [],
    "panels": [
      {
        "collapsed": false,
        "gridPos": {
          "h": 1,
          "w": 24,
          "x": 0,
          "y": 0
        },
        "id": 1,
        "panels": [],
        "title": "Signs of misuse (each has an alert)",
        "type": "row"
      },
      {
        "datasource": {
          "type": "loki",
          "uid": "loki"
        },
        "description": "Spent codes or used refresh tokens that came back, in the selected range. Each ended its grant (reason reuse). Alert: OAuth code or refresh token reused.",
        "fieldConfig": {
          "defaults": {
            "color": {
              "mode": "thresholds"
            },
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {
                  "color": "green",
                  "value": null
                },
                {
                  "color": "red",
                  "value": 1
                }
              ]
            },
            "unit": "short",
            "noValue": "0"
          },
          "overrides": []
        },
        "gridPos": {
          "h": 4,
          "w": 4,
          "x": 0,
          "y": 1
