                    "accountId": "${REALM_SERVER_LOG_GROUP_ACCOUNT_ID}",
                    "arn": "arn:aws:logs:us-east-1:${REALM_SERVER_LOG_GROUP_ACCOUNT_ID}:log-group:${REALM_SERVER_LOG_GROUP_NAME}",
                    "name": "${REALM_SERVER_LOG_GROUP_NAME}"
