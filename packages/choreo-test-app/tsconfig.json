{
  "extends": "@ember/app-tsconfig",
  "include": ["app", "tests", "types"],
  "compilerOptions": {
    "allowJs": true,
    /**
      https://www.typescriptlang.org/tsconfig#noEmitOnError
      Do not block emit on TS errors.
    */
    "noEmitOnError": false,

    "declaration": false,
    "declarationMap": false,

    /**
      https://www.typescriptlang.org/tsconfig#allowImportingTsExtensions

      We want our tooling to know how to resolve our custom files so the appropriate plugins
      can do the proper transformations on those files.
    */
    "allowImportingTsExtensions": true,
    "paths": {
      "test-app/tests/*": ["./tests/*"],
      "test-app/*": ["./app/*"],
      /**
        glimmer-motion and choreo-player resolve to their source, so
        type-checking needs neither package built. Their package.json#exports
        point types at the build output that npm consumers get.
      */
      "glimmer-motion": ["../glimmer-motion/src/index.ts"],
      "glimmer-motion/*": ["../glimmer-motion/src/*"],
      "choreo-player": ["../choreo-player/src/index.ts"],
      "choreo-player/hyperframes": ["../choreo-player/src/hyperframes.ts"],
      "*": ["./types/*"]
    },
    "types": ["ember-source/types"]
  }
}
