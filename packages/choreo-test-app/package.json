    "@babel/plugin-transform-typescript": "^7.29.7",
    "@babel/runtime": "^7.29.0",
    "@ember/app-tsconfig": "^2.0.0",
    "@ember/optional-features": "^2.3.0",
    "@ember/string": "^4.0.1",
