{
  "name": "@cardstack/secure-origin",
  "version": "0.0.0",
  "private": true,
  "description": "The secure origin's pages: the secure window's shell and the credential fields the app frames, built as their own Ember app.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "node build/ensure-icons.ts && vite build",
    "build:if-stale": "node build/ensure-build.ts",
    "lint": "concurrently \"pnpm:lint:*(!fix)\" --names \"lint:\"",
    "lint:fix": "concurrently \"pnpm:lint:*:fix\" --names \"fix:\"",
    "lint:build": "node build/ensure-icons.ts && SECURE_ORIGIN_BUILD_RECORD=check vite build --outDir dist-lint --emptyOutDir && node build/ensure-build.ts --check dist-lint",
    "lint:js": "eslint . --report-unused-disable-directives --cache",
    "lint:js:fix": "eslint . --report-unused-disable-directives --fix",
    "lint:hbs": "ember-template-lint . --no-error-on-unmatched-pattern",
    "lint:hbs:fix": "ember-template-lint . --no-error-on-unmatched-pattern --fix",
    "lint:pretui": "node build/pret-ui-lint.ts",
    "test": "pnpm test:unit && pnpm test:components",
    "lint:types": "node build/type-check.ts",
    "test:unit": "node --test 'tests/**/*.test.ts'",
    "test:components": "node build/ensure-icons.ts && NODE_ENV=development vite build --mode=development --outDir dist-tests && ember test --config-file testem.cjs --path dist-tests"
  },
  "exports": {
    "./package.json": "./package.json",
    "./components/*": "./src/components/*",
    "./screens/*": "./src/screens/*",
    "./security/*": "./src/security/*",
    "./shell/*": "./src/shell/*",
    "./telemetry/*": "./src/telemetry/*",
    "./dist/*": "./dist/*"
  },
  "dependencies": {
    "@babel/runtime": "catalog:",
    "@cardstack/boxel-icons": "workspace:*",
    "@cardstack/pretui": "workspace:*",
    "@glimmer/component": "catalog:",
    "decorator-transforms": "catalog:",
    "ember-source": "catalog:"
  },
  "devDependencies": {
    "@babel/core": "catalog:",
    "@babel/plugin-transform-runtime": "^7.29.0",
    "@babel/plugin-transform-typescript": "catalog:",
    "@ember/test-helpers": "catalog:",
    "@ember/test-waiters": "catalog:",
    "@embroider/core": "^4.6.3",
    "@embroider/macros": "^1.20.5",
    "@embroider/vite": "^1.7.10",
    "@glint/ember-tsc": "catalog:",
    "@glint/template": "catalog:",
    "@rollup/plugin-babel": "catalog:",
    "@types/node": "catalog:",
    "@types/qunit": "catalog:",
    "babel-plugin-ember-template-compilation": "catalog:",
    "concurrently": "catalog:",
    "ember-cli": "~6.12.0",
    "ember-concurrency": "catalog:",
    "ember-eslint-parser": "catalog:",
    "ember-qunit": "catalog:",
    "ember-template-lint": "catalog:",
    "eslint": "catalog:",
    "eslint-plugin-ember": "catalog:",
    "eslint-plugin-qunit": "catalog:",
    "glimmer-scoped-css": "catalog:",
    "prettier": "catalog:",
    "qunit": "catalog:",
    "qunit-dom": "catalog:",
    "typescript": "catalog:",
    "vite": "^8.0.10"
  },
  "engines": {
    "node": ">=22.16.0"
  },
  "ember": {
    "edition": "octane"
  },
  "ember-addon": {
    "type": "app",
    "version": 2
  }
}
