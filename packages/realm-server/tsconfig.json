{
  "compilerOptions": {
    // es2022, not es2020: this package runs on the Node pinned in
    // .mise.toml (24.x), and `target` with no explicit `lib` is what decides
    // which built-ins the checker believes exist. At es2020 it does not
    // believe in `Array.prototype.at`, which ES2022 added and which the
    // vendored Deck core uses — so the claim was already inaccurate and
    // merely happened not to be load-bearing before. Raising it only ADDS
    // library declarations (it cannot introduce new errors), and `noEmit`
    // is on, so nothing about the output changes.
    "target": "es2022",
    "allowJs": true,
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "allowSyntheticDefaultImports": true,
    "allowImportingTsExtensions": true,
    "noImplicitAny": true,
    "noImplicitThis": true,
    "alwaysStrict": true,
    "strictNullChecks": true,
    "strictPropertyInitialization": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "noEmitOnError": false,
    "noEmit": true,
    "inlineSourceMap": true,
    "inlineSources": true,
    "baseUrl": ".",
    "esModuleInterop": true,
    "experimentalDecorators": true,
    "skipLibCheck": true,
    "strict": true,
    "paths": {
      "@cardstack/base/*": [
        "../base/*.gts",
        "../base/*.ts",
        "../base/*.d.ts",
        "../base/*"
      ],
      "https://cardstack.com/base/*": [
        "../base/*.gts",
        "../base/*.ts",
        "../base/*.d.ts",
        "../base/*"
      ],
      "@cardstack/boxel-ui": ["../boxel-ui"],
      "@cardstack/boxel-ui/*": ["../boxel-ui/*"]
    },
    "types": ["@cardstack/local-types"]
  },
  "include": ["../base/**/*", "./**/*"],
  "exclude": [
    "../base/**/__boxel/**",
    "./realms/**",
    "./tests/fixtures/**",
    "./scripts/bench-realm/fixtures/**"
  ]
}
