import {
  CardDef,
  Component,
  contains,
  field,
  realmURL,
} from '@cardstack/base/card-api';
import StringField from '@cardstack/base/string';
import { tracked } from '@glimmer/tracking';
import { action } from '@ember/object';
import { fn } from '@ember/helper';
import { on } from '@ember/modifier';
import type Owner from '@ember/owner';

type ViewSelector =
  | { kind: 'version'; spec: string }
  | { kind: 'branch'; branch: string };

interface AstraRequest {
  schema: 'boxel-astra-query-v1';
  query: { text?: string };
  views: ViewSelector[];
  compare?: { from: number; to: number };
}

interface AstraCard {
  logicalRRI: string;
  sourcePath: string;
  document: {
    data?: {
      attributes?: {
        title?: string;
        name?: string;
        layer?: string;
        owner?: string;
        sourceVersion?: string;
        state?: string;
      };
    };
  };
}

interface AstraView {
  provenance: {
    kind: 'version' | 'branch' | 'checkpoint' | 'index';
    mutability: 'mutable' | 'immutable';
    resolved?: string;
    branch?: string;
    treeHash: string;
    indexHash: string;
  };
  cards: AstraCard[];
}

interface AstraResult {
  views: AstraView[];
  comparison?: {
    added: string[];
    changed: string[];
    removed: string[];
    unchanged: string[];
  };
}

const VIEWS: ViewSelector[] = [
  { kind: 'version', spec: '0.9.0' },
  { kind: 'version', spec: '1.0.0' },
  { kind: 'version', spec: '1.1.0-dev.1' },
  { kind: 'branch', branch: 'main' },
];

const SAMPLE_GROUPS = [
  {
    numeral: '01',
    title: 'The release surface',
    blurb: 'Ask what exists across every exact view.',
    samples: [
      ['Everything', ''],
      ['Controls', 'control'],
      ['Fields', 'field'],
      ['Layout primitives', 'layout'],
    ],
  },
  {
    numeral: '02',
    title: 'The team',
    blurb: 'Follow ownership across the release train.',
    samples: [
      ['Mina Park', 'Mina Park'],
      ['Jo Bell', 'Jo Bell'],
      ['Ana Costa', 'Ana Costa'],
      ['Leo Wong', 'Leo Wong'],
    ],
  },
  {
    numeral: '03',
    title: 'The evolving system',
    blurb: 'Find concepts whose presence changes by Version.',
    samples: [
      ['Known Date', 'known date'],
      ['Available components', 'available'],
      ['Development locks', 'development'],
      ['Design review', 'design review'],
    ],
  },
] as const;

function requestFor(text: string): AstraRequest {
  return {
    schema: 'boxel-astra-query-v1',
    query: text ? { text } : {},
    views: VIEWS,
    compare: { from: 0, to: 1 },
  };
}

function shortHash(hash: string): string {
  return hash.slice(0, 10);
}

export class AstraHarness extends CardDef {
  static displayName = 'Astra Query Harness';
  static prefersWideFormat = true;
  @field title = contains(StringField);
  @field query = contains(StringField);
  @field from = contains(StringField);
  @field to = contains(StringField);
  @field viewCount = contains(StringField);
  @field added = contains(StringField);
  @field changed = contains(StringField);
  @field removed = contains(StringField);
  @field unchanged = contains(StringField);
  @field evidence = contains(StringField);
}

class AstraHarnessIsolated extends Component<typeof AstraHarness> {
  @tracked draft = JSON.stringify(requestFor(''), null, 2);
  @tracked activeLabel = 'Everything';
  @tracked result: AstraResult | undefined;
  @tracked population: AstraResult | undefined;
  @tracked error: string | undefined;
  @tracked loading = false;
  private runNumber = 0;

  constructor(owner: Owner, args: any) {
    super(owner, args);
    void this.loadInitial();
  }

  private get endpoint(): string {
    let root = this.args.model[realmURL]?.href;
    return root ? new URL('.deck/astra/query', root).href : '';
  }

  private async queryAstra(request: AstraRequest): Promise<AstraResult> {
    if (!this.endpoint) {
      throw new Error('This card is not attached to a Realm.');
    }
    let response = await fetch(this.endpoint, {
      method: 'POST',
      headers: {
        Accept: 'application/json',
        'Content-Type': 'application/json',
      },
      body: JSON.stringify(request),
    });
    if (!response.ok) {
      throw new Error(`${response.status} · ${await response.text()}`);
    }
    return (await response.json()) as AstraResult;
  }

  private async loadInitial() {
    this.loading = true;
    this.error = undefined;
    try {
      [this.population, this.result] = await Promise.all([
        this.queryAstra(requestFor('')),
        this.queryAstra(requestFor('')),
      ]);
    } catch (error) {
      this.error = error instanceof Error ? error.message : String(error);
    } finally {
      this.loading = false;
    }
  }

  get sampleGroups() {
    return SAMPLE_GROUPS.map((group) => ({
      ...group,
      samples: group.samples.map(([label, text]) => ({
        label,
        text,
        state: label === this.activeLabel ? 'active' : 'idle',
      })),
    }));
  }

  private labelFor(view: AstraView): string {
    return view.provenance.kind === 'version'
      ? (view.provenance.resolved ?? 'Version')
      : `${view.provenance.branch ?? view.provenance.kind} · ${shortHash(view.provenance.treeHash)}`;
  }

  get viewRows() {
    return (this.population?.views ?? []).map((populationView, index) => {
      let resultView = this.result?.views[index];
      let hits = new Set(
        (resultView?.cards ?? []).map((card) => card.sourcePath),
      );
      return {
        label: this.labelFor(populationView),
        mutability: populationView.provenance.mutability,
        indexHash: shortHash(populationView.provenance.indexHash),
        count: resultView?.cards.length ?? 0,
        total: populationView.cards.length,
        verdict: (resultView?.cards.length ?? 0) > 0 ? 'matched' : 'no match',
        dots: populationView.cards.map((card) => ({
          title: card.document.data?.attributes?.title ?? card.sourcePath,
          state: hits.has(card.sourcePath) ? 'hit' : 'miss',
        })),
      };
    });
  }

  get comparison() {
    return (
      this.result?.comparison ?? {
        added: [],
        changed: [],
        removed: [],
        unchanged: [],
      }
    );
  }

  get matchedTotal() {
    return (this.result?.views ?? []).reduce(
      (total, view) => total + view.cards.length,
      0,
    );
  }

  get populationTotal() {
    return (this.population?.views ?? []).reduce(
      (total, view) => total + view.cards.length,
      0,
    );
  }

  get hits() {
    return (this.result?.views ?? []).flatMap((view) =>
      view.cards.slice(0, 8).map((card) => {
        let attributes = card.document.data?.attributes;
        return {
          view: this.labelFor(view),
          title: attributes?.title ?? card.sourcePath,
          layer: attributes?.layer ?? 'card',
          owner: attributes?.owner ?? 'PretUI',
          version: attributes?.sourceVersion ?? 'workspace',
        };
      }),
    );
  }

  @action updateDraft(event: Event) {
    this.draft = (event.target as HTMLTextAreaElement).value;
  }

  @action maybeRun(event: Event) {
    if (
      event instanceof KeyboardEvent &&
      event.key === 'Enter' &&
      (event.metaKey || event.ctrlKey)
    ) {
      event.preventDefault();
      void this.run();
    }
  }

  @action loadSample(text: string, label: string) {
    this.draft = JSON.stringify(requestFor(text), null, 2);
    this.activeLabel = label;
    void this.run();
  }

  @action async run() {
    let runNumber = ++this.runNumber;
    this.loading = true;
    this.error = undefined;
    try {
      let request = JSON.parse(this.draft) as AstraRequest;
      let result = await this.queryAstra(request);
      if (runNumber === this.runNumber) {
        this.result = result;
      }
    } catch (error) {
      if (runNumber === this.runNumber) {
        this.error = error instanceof Error ? error.message : String(error);
      }
    } finally {
      if (runNumber === this.runNumber) {
        this.loading = false;
      }
    }
  }

  <template>
    <section class='console'>
      <div class='sheet'>
        <header class='masthead'>
          <div class='mast-row'>
            <span class='eyebrow'>Astra · PretUI · four exact views</span>
            <span class='protocol'><i></i>live protocol</span>
          </div>
          <h1>Ask across the release.</h1>
          <p>Twenty-eight design-system components, four team-owned layers,
            three immutable Versions, and mutable main. One query shows what
            exists in every reality without changing Workspace context.</p>
        </header>

        <hr />

        <section class='ledger'>
          <div class='section-head'>
            <span class='eyebrow'>The corpus · every card, and what this query
              did with it</span>
            <span class='legend'><i data-state='hit'></i>matched<i
                data-state='miss'
              ></i>no match</span>
          </div>
          <div class='views'>
            {{#each this.viewRows as |view|}}
              <article class='view'>
                <div class='view-top'>
                  <code>{{view.label}}</code>
                  <span
                    data-mutability={{view.mutability}}
                  >{{view.mutability}}</span>
                </div>
                <div class='dots'>
                  {{#each view.dots as |dot|}}
                    <i data-state={{dot.state}} title={{dot.title}}></i>
                  {{/each}}
                </div>
                <div class='view-foot'>
                  <b>{{view.count}} / {{view.total}}</b>
                  <span>{{view.verdict}} · index {{view.indexHash}}</span>
                </div>
              </article>
            {{else}}
              <p class='muted'>Reading the indexed views…</p>
            {{/each}}
          </div>
        </section>

        <hr />

        <div class='columns'>
          <aside class='rail'>
            {{#each this.sampleGroups as |group|}}
              <section>
                <div class='group-head'>
                  <span>{{group.numeral}}</span>
                  <div><b>{{group.title}}</b><small
                    >{{group.blurb}}</small></div>
                </div>
                <ul>
                  {{#each group.samples as |sample|}}
                    <li><button
                        type='button'
                        data-state={{sample.state}}
                        {{on
                          'click'
                          (fn this.loadSample sample.text sample.label)
                        }}
                      >{{sample.label}}</button></li>
                  {{/each}}
                </ul>
              </section>
            {{/each}}
          </aside>

          <section class='ask'>
            <div class='pane-head'><span class='eyebrow'>The question</span><kbd
              >⌘ Enter</kbd></div>
            <div class='brief'><b>{{this.activeLabel}}</b><span>Edit the
                protocol request directly, or choose a question from the rail.</span></div>
            <textarea
              aria-label='Astra query JSON'
              spellcheck='false'
              {{on 'input' this.updateDraft}}
              {{on 'keydown' this.maybeRun}}
            >{{this.draft}}</textarea>
            <div class='actions'>
              <button type='button' {{on 'click' this.run}}>Run query</button>
              {{#if this.loading}}<span>running…</span>{{else}}<span>POST
                  /.deck/astra/query</span>{{/if}}
            </div>
            {{#if this.error}}
              <div class='alert'><b>Query refused</b><span
                >{{this.error}}</span></div>
            {{/if}}
          </section>

          <section class='answer'>
            <div class='pane-head'><span class='eyebrow'>The answer</span><span
                class='ran'
              >{{this.activeLabel}}</span></div>
            <div class='stat'><b>{{this.matchedTotal}}</b><span
              >matches</span><small>of
                {{this.populationTotal}}
                card appearances across four views</small></div>
            <div class='delta'>
              <span><b>+{{this.comparison.added.length}}</b>added</span>
              <span><b>~{{this.comparison.changed.length}}</b>changed</span>
              <span><b>−{{this.comparison.removed.length}}</b>removed</span>
              <span><b>{{this.comparison.unchanged.length}}</b>unchanged</span>
            </div>
            <ul class='hits'>
              {{#each this.hits as |hit|}}
                <li><code>{{hit.view}}</code><div><b>{{hit.title}}</b><span
                    >{{hit.layer}}
                      ·
                      {{hit.owner}}
                      ·
                      {{hit.version}}</span></div></li>
              {{else}}
                <li class='empty'><b>Nothing matched.</b><span>The ledger still
                    shows every card that was asked and answered no.</span></li>
              {{/each}}
            </ul>
          </section>
        </div>

        <footer><span>RRI identity · immutable index generations · exact
            provenance</span><code>{{@model.evidence}}</code></footer>
      </div>
    </section>

