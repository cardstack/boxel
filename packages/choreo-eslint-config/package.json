{
  "name": "@cardstack/choreo-eslint-config",
  "version": "0.0.0",
  "private": true,
  "description": "ESLint flat config shared by the Choreo packages.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./index.mjs"
  },
  "scripts": {
    "lint": "concurrently \"pnpm:lint:*(!fix)\" --names \"lint:\" --prefixColors auto",
    "lint:fix": "concurrently \"pnpm:lint:*:fix\" --names \"fix:\" --prefixColors auto",
    "lint:format": "prettier . --cache --check",
    "lint:format:fix": "prettier . --cache --write",
    "lint:js": "eslint . --cache",
    "lint:js:fix": "eslint . --fix"
  },
  "peerDependencies": {
    "eslint": "^9.39.4"
  },
  "dependencies": {
    "@eslint/js": "^9.39.4",
    "eslint-config-prettier": "catalog:",
    "eslint-plugin-ember": "catalog:",
    "eslint-plugin-n": "catalog:",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "eslint-plugin-typescript-sort-keys": "catalog:",
    "globals": "^15.15.0",
    "typescript-eslint": "catalog:"
  },
  "devDependencies": {
    "concurrently": "catalog:",
    "eslint": "^9.39.4",
    "prettier": "catalog:",
    "typescript": "catalog:"
  }
}
